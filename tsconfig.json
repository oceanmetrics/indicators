{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "checkJs": false,
    "paths": { "maplibre-gl": ["./node_modules/maplibre-gl"] }
  },
  "include": ["src/**/*.ts", "viewer/src/**/*.ts", "viewer/src/**/*.svelte", "viewer/vite.config.ts", "vitest.config.ts"]
}
