{
  "name": "om-indicators",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ocean Metrics Indicators: status methods, coverage builder, icons and the viewer",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config viewer/vite.config.ts",
    "build": "vite build --config viewer/vite.config.ts",
    "preview": "vite preview --config viewer/vite.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "coverage:build": "node --experimental-strip-types src/coverage/cli.ts",
    "changes:build": "node --experimental-strip-types src/coverage/changes.ts",
    "icons:paths": "node brand/build-icon-paths.mjs",
    "icons:build": "node brand/build-icons.mjs",
    "icons:sheet": "node brand/icon-sheet.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^24.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@marinebon/ui": "github:marinebon/ui#v0.4.0",
    "@mdi/js": "7.4.47",
    "@oceanmetrics/catalog": "^0.5.0",
    "@oceanmetrics/engine": "^0.1.2",
    "@oceanmetrics/map": "^0.3.1",
    "@oceanmetrics/nav": "^0.1.0",
    "@oceanmetrics/status": "^0.1.1",
    "apache-arrow": "^17.0.0",
    "hyparquet": "^1.30.1",
    "hyparquet-compressors": "^1.1.2",
    "hyparquet-writer": "^0.16.13",
    "maplibre-gl": "^6.13.0",
    "pmtiles": "^4.5.0"
  }
}
